# habitat-server 环境变量
PORT=3000
HOST=0.0.0.0

# CORS 允许的来源，**逗号分隔**。留空 / 不设 = 反射任意来源（**仅本地开发可接受**）。
# 上线前必须收紧到具体域名，否则任何网站都能拿浏览器里的凭证打你的服务端（技术方案 §9-3）。
# 例：CORS_ORIGIN=https://beiyan.cc,https://www.beiyan.cc
CORS_ORIGIN=

# SQLite 数据文件路径（默认 ./data/habitat.db）
HABITAT_DB_PATH=./data/habitat.db

# 账本日键与主动行为默认时区。主动策略可通过 /api/automation 覆盖，生产主机即使跑 UTC 也不会串天。
HABITAT_TIME_ZONE=Asia/Shanghai

# Nocturne MCP（Streamable HTTP）；本地开发可用 npm run dev:mock-mcp 起 mock 后填 http://localhost:3333/mcp
# 想验证「客户端代码打真实 server」可临时填官方只读 Demo（无需 token，只开放 read_memory / search_memory）：
#   MCP_NOCTURNE_URL=https://misaligned.top/mcp  →  然后跑 npx tsx scripts/probe-nocturne-demo.ts
MCP_NOCTURNE_URL=
MCP_NOCTURNE_TOKEN=
# 可选：同一个 Nocturne 实例托管多个 AI 时，用 namespace 隔离；单人格留空即可。
MCP_NOCTURNE_NAMESPACE=

# Eventide Python sidecar（Phase 3B）。留空 = 状态系统未配置，habitat-server 仍可正常启动。
# 本地：先按 eventide-sidecar/README.md 安装，再启动到 127.0.0.1:8234。
EVENTIDE_URL=

# Web Push（Phase 4，可选）。三项齐全才启用；不配置时站内通知中心仍完整可用。
# 可用 `npx web-push generate-vapid-keys` 生成公私钥。subject 必须是 mailto: 或 https: URL。
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:habitat@example.com

# 仅 dev:mock-mcp 使用
MOCK_MCP_PORT=3333

# ---------- LLM 方案（技术方案 §6.2 ApiProfile / §7.1） ----------
# JSON 数组。每一项 = 一份「baseUrl + 鉴权 + 模型映射」的组合，换服务商/换模型只改这里。
#   baseUrl  不带结尾斜杠；兼容层会自动拼 /chat/completions 与 /models
#   keyRef   填「持有该密钥的环境变量名」——密钥本身**不要**写在这个文件里
#            留空串 "" 表示该上游不需要鉴权（本地 vLLM / Ollama）
#   modelMap 至少要有 chat
#   headers  可选，附加请求头（部分中转需要）
#   streamOptions 可选，布尔；缺省 true。流式请求带 stream_options 才能拿到末包 usage（账本要用），
#            只有老自建上游（老版 vLLM、部分代理）因它回 400 时才设 false
# 注意：真实环境变量优先于本文件；.env 不存在也不会报错。
#
# 例 1 · DeepSeek 官方：
# HABITAT_LLM_PROFILES=[{"id":"deepseek","name":"DeepSeek 官方","provider":"openai-compat","baseUrl":"https://api.deepseek.com/v1","keyRef":"DEEPSEEK_API_KEY","modelMap":{"chat":"deepseek-chat"},"isActive":true}]
# 例 2 · 本地 mock 上游（配合 npm run dev:mock-openai，无需真实密钥）：
# HABITAT_LLM_PROFILES=[{"id":"mock","name":"本地 mock","provider":"openai-compat","baseUrl":"http://127.0.0.1:3334/v1","keyRef":"MOCK_KEY","modelMap":{"chat":"mock-chat-small"},"isActive":true}]
# MOCK_KEY=sk-mock
HABITAT_LLM_PROFILES=

# 仅 dev:mock-openai 使用
MOCK_OPENAI_PORT=3334

# 上面各 keyRef 指向的密钥，按需在下方或 shell 里设置（真实密钥请写进 .env，那个文件已被 .gitignore 忽略）
# DEEPSEEK_API_KEY=
